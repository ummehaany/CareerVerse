rules_version = '2';

// Cloud Storage security rules for CareerVerse.
service firebase.storage {
  match /b/{bucket}/o {
    // Profile avatars: users/{uid} own their folder.
    // Avatars are publicly readable (they appear on public profiles), but only
    // the owner may write, and only small image files.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
