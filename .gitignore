# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
build.log
dev.log

# local scratch / personal diagnostic data — not for the repo.
# The reusable scripts/*.ts diagnostics themselves ARE committed; only their
# throwaway scratch files and generated per-user output are excluded here.
scripts/__tmp_*
scripts/my-discovery-answers.json

# dev-notes/ — local-only working notes: audit reports, formula/scoring
# investigation logs, and other internal session write-ups. Real documentation
# lives in README.md and docs/; the durable "why" behind each change also
# lives in code comments (see scoring.ts, traits.ts, normalize.ts,
# recommendation-fallback.ts, etc.). Nothing in this folder is meant for the
# public repo — delete this line if you ever want to commit it intentionally.
/dev-notes/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
